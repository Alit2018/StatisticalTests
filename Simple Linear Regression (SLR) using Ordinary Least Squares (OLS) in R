# Dataset from the table
study_hours <- c(1, 2, 3, 4, 5, 6, 7, 8, 9, 2, 3, 6, 10, 4)
exam_score  <- c(55, 62, 68, 72, 78, 83, 88, 93, 100, 100, 71, 86, 98, 76)

# Fit the linear regression model (exam_score predicted by study_hours)
model <- lm(exam_score ~ study_hours)

# Display full statistical summary (slope, intercept, R-squared, t-stat, p-value)
summary(model)

# Predict exam score for 10 study hours
new_data <- data.frame(study_hours = 10)
predicted_score <- predict(model, newdata = new_data)

cat(sprintf("Predicted score for 5.5 hours: %.2f\n", predicted_score))
